# Copy to .env for local development. Never commit real credentials.
# PostgreSQL connection URI from Supabase or another managed PostgreSQL provider.
# Leave empty to use temporary in-memory storage locally only.
DATABASE_URL=

# Runtime settings
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Temporary protected platform-admin API gate.
# Generate a long random secret. Never use this key in frontend/mobile code.
SWIFTSERVE_ADMIN_API_KEY=

# Hosted payment checkout is disabled unless a provider and credentials are configured.
PAYMENT_PROVIDER=
PAYMENT_RETURN_URL=

# Paystack server-only secret. Configure PAYSTACK_WEBHOOK_SECRET where using
# the current timestamped webhook signature; the legacy signature path uses
# PAYSTACK_SECRET_KEY.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_SUPPORTED_CURRENCIES=NGN,GHS,ZAR,KES

# Flutterwave server-only secret and webhook secret hash.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_SUPPORTED_CURRENCIES=NGN,GHS,KES,UGX,TZS,ZAR,EUR,GBP,USD,RWF,XOF,XAF

# Optional API base URL overrides for controlled test environments.
# Do not point production credentials to an untrusted endpoint.
PAYSTACK_API_BASE_URL=
FLUTTERWAVE_API_BASE_URL=
