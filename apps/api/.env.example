# Copy to .env for local development. Never commit real credentials.
# PostgreSQL connection URI from Supabase or another managed PostgreSQL provider.
# Leave empty to use temporary in-memory storage locally only.
DATABASE_URL=

# Runtime settings
NODE_ENV=development
HOST=127.0.0.1
PORT=3000


# One-time secret used only to create the first platform super administrator.
# Remove or rotate it after successful bootstrap. Never commit a real secret.
SWIFTSERVE_ADMIN_BOOTSTRAP_KEY=
