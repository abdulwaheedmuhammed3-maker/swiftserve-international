# Copy to .env for local development. Never commit real credentials.
# PostgreSQL connection URI from Supabase or another managed PostgreSQL provider.
# Leave empty to use temporary in-memory storage locally only.
DATABASE_URL=

# Runtime settings
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

 
# Optional non-secret label for the admin API key in audit records.
# This labels the credential, not the individual administrator using it.
SWIFTSERVE_ADMIN_ACTOR_ID=shared-admin-key

# Platform operations
SWIFTSERVE_ADMIN_API_KEY=
